---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GameList from '../components/GameList.astro';
import { getDatabase } from '../lib/db';
import { getGameFilterOptions, getGamesPage } from '../lib/games';

export const prerender = true;
const page = await getGamesPage(getDatabase(), 1, 9);
const filterOptions = await getGameFilterOptions(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero title="Welcome to Tailspin Toys" subtitle="Find your next game! And maybe even back one! Explore our collection!" />
    <h2 class="mb-6 text-2xl font-medium text-slate-100">Featured Games</h2>
    <GameList
      games={page.games}
      filterOptions={filterOptions}
      currentPage={page.page}
      totalPages={page.totalPages}
      totalGames={page.totalGames}
    />
  </div>
</Layout>
