---
import EmptyState from './EmptyState.astro';
import GameCard from './GameCard.astro';
import Pagination from './Pagination.astro';
import type { Game } from '../types/game';
import type { GameFilterOptions } from '../lib/games';

/**
 * Renders a paginated game grid with client-side filters for the current page.
 */
interface Props {
    /** Games for the current static page. */
    games: Game[];
    /** Category and publisher choices for the client-side filters. */
    filterOptions: GameFilterOptions;
    /** The one-based page currently being rendered. */
    currentPage: number;
    /** The total number of generated game-list pages. */
    totalPages: number;
    /** Total games in the catalog, used in the status text. */
    totalGames: number;
}

const { games, filterOptions, currentPage, totalPages, totalGames } = Astro.props;
---

{games.length === 0 ? (
    <EmptyState text="No games available at the moment." />
) : (
    <>
        <form class="mb-8 grid grid-cols-1 gap-6 rounded-xl border border-slate-700 bg-slate-800/50 p-6 md:grid-cols-2" data-testid="game-filters">
            <div>
                <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Filter by category</label>
                <select id="category-filter" name="category" multiple size={Math.min(Math.max(filterOptions.categories.length, 2), 5)} aria-describedby="category-filter-help" data-testid="category-filter" class="min-h-24 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    {filterOptions.categories.map((category) => <option value={category.id}>{category.name}</option>)}
                </select>
                <p id="category-filter-help" class="mt-2 text-xs text-slate-400">Hold Ctrl or Command to select more than one category.</p>
            </div>
            <div>
                <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Filter by publisher</label>
                <select id="publisher-filter" name="publisher" data-testid="publisher-filter" class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">All publishers</option>
                    {filterOptions.publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
            </div>
            <div class="flex items-center justify-between gap-4 md:col-span-2">
                <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-result-count">Showing {games.length} of {totalGames} games</p>
                <button type="reset" data-testid="clear-filters" class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none">Clear filters</button>
            </div>
        </form>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
        </div>
        <div class="hidden" data-testid="filter-empty-state"><EmptyState text="No games match the selected filters." /></div>
        <Pagination currentPage={currentPage} totalPages={totalPages} />
    </>
)}

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  const updateGameFilters = (): void => {
    if (!categoryFilter || !publisherFilter || !resultCount || !emptyState) return;
    const selectedCategories = new Set(Array.from(categoryFilter.selectedOptions, (option) => option.value));
    const selectedPublisher = publisherFilter.value;
    let visibleCount = 0;
    cards.forEach((card) => {
      const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches = selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const isVisible = categoryMatches && publisherMatches;
      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });
    resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} on this page`;
    emptyState.classList.toggle('hidden', visibleCount !== 0);
  };
  filterForm?.addEventListener('change', updateGameFilters);
  filterForm?.addEventListener('reset', () => requestAnimationFrame(updateGameFilters));
</script>
